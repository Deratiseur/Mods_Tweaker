BEGIN @18 DESIGNATED 18 LABEL Px_MTWK_Mawgul
REQUIRE_COMPONENT ~MawgulNPC.tp2~ 0 @18000
COPY_EXISTING ~AR0512.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
  REPLACE_TEXTUALLY ~IF
	Global("MauroExists","AR0512",0)
THEN~ ~IF
	XPGT(Player1,1999999)
	Global("MauroExists","AR0512",0)
THEN~
  END
 BUT_ONLY

