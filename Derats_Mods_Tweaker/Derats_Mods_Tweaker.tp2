BEGIN @4 DESIGNATED 4 LABEL Px_MTWK_Moddie1
REQUIRE_COMPONENT ~FoxMonster.tp2~ 0 @5000
ACTION_IF GAME_IS ~BG2 TOB BGT~ THEN BEGIN	
COPY ~Derats_Mods_Tweaker/Componants/Moddie/BG2~ ~override~
COPY ~Derats_Mods_Tweaker/Componants/Moddie/MODDIEL.bmp~ ~override~
END
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN	
COPY ~Derats_Mods_Tweaker/Componants/Moddie/EE~ ~override~
END

BEGIN @5 DESIGNATED 5 LABEL Px_MTWK_Moddie2
REQUIRE_COMPONENT ~FoxMonster.tp2~ 0 @5000
COMPILE ~Derats_Mods_Tweaker/Componants/Moddie/Z_ModdyJ.d~

BEGIN @22 DESIGNATED 22 LABEL Px_MTWK_TTSQ2
REQUIRE_COMPONENT ~TTSQ.tp2~ 0 @19000
ACTION_IF GAME_IS ~BG2 TOB BGT~ THEN BEGIN	
COPY ~Derats_Mods_Tweaker/Componants/TTSQ/BG2~ ~override~
COPY ~Derats_Mods_Tweaker/Componants/TTSQ/metbae2L.bmp~ ~override~
END
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN	
COPY ~Derats_Mods_Tweaker/Componants/TTSQ/EE~ ~override~
END
COPY_EXISTING ~metbae.cre~ ~override~
			  ~metbae2.cre~ ~override~	WRITE_ASCII 0x34 ~metbae2S~ #8	WRITE_ASCII 0x3c ~metbae2M~ #8

BEGIN @23 DESIGNATED 23 LABEL Px_MTWK_TTSQ3
REQUIRE_COMPONENT ~TTSQ.tp2~ 0 @19000
COPY_EXISTING ~metbae.cre~ ~override/metbae2.cre~	WRITE_ASCII 0x2cc ~metbae2~ #8
     GET_OFFSET_ARRAY item_arr CRE_V10_ITEMS
     PHP_EACH item_arr AS ind=>item_off BEGIN
       WRITE_BYTE (0x10 + item_off) (BNOT (BIT1 BOR BIT3) BAND SHORT_AT (0x10 + item_off))
		END

BEGIN @19 DESIGNATED 19 LABEL Px_MTWK_TTSQ
REQUIRE_COMPONENT ~TTSQ.tp2~ 0 @19000
COPY_EXISTING ~cutbae.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
  REPLACE_TEXTUALLY ~TakePartyItem("metwaso")~ ~AddexperienceParty(10000)
	TakePartyItem("metwaso")~
  END
 BUT_ONLY

BEGIN @6 DESIGNATED 6 LABEL Px_MTWK_Nina1
REQUIRE_COMPONENT ~Nina.tp2~ 0 @7000
ACTION_IF GAME_IS ~BG2 TOB BGT~ THEN BEGIN
COPY ~Derats_Mods_Tweaker/Componants/Nina/Portraits~ ~override~
END
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
COPY ~Derats_Mods_Tweaker/Componants/Nina/PortraitsEE~ ~override~
END

