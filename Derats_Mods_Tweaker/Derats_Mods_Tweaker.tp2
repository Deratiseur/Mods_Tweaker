BEGIN @15 DESIGNATED 15 LABEL Px_MTWK_Interplan
REQUIRE_COMPONENT ~derats_magasin_2.tp2~ 33 @15000
COMPILE ~Derats_Mods_Tweaker/Componants/Interplan/pxinter1.d~ USING ~Derats_Mods_Tweaker/Languages/%LANGUAGE%/Interplan.tra~
EXTEND_TOP ~AR5500.BCS~	~Derats_Mods_Tweaker/Componants/Interplan/AR5500.baf~
COPY ~Derats_Mods_Tweaker/Componants/Interplan/pxinter1.sto~ ~override~
  SAY 0xc @15998
  // Objets du Coffre chercheur : ordre du readme de l'Interplan v10
  // Chaque objet n'est ajoute que si son fichier ITM existe dans le jeu.
    // 01. L'Anathème d'Ao
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2anat.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2anat~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 02. Mort silencieuse
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2mrts.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2mrts~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 03. Vastanir
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2vast.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2vast~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 04. Buveuse de sorts
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2buve.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2buve~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 05. La fameuse Killsword01
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2kils.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2kils~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 06. Destructrice de Plunifène
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2dest.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2dest~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 07. Cœur doré de CHARNAME (IWD2)
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2coeu.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2coeu~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 08. Hachette de Viccilo
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2vicc.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2vicc~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 09. Eviscérator (PST)
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2evis.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2evis~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 10. La masse du saint (P&P)
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2msai.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2msai~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 11. Vridomir, le fléau non-mort
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2vrid.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2vrid~ LAST #1 #0 #0 ~IDENTIFIED~ #1
    END
    // 12. Courroux de la nature
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2vnat.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2vnat~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 13. Arc en fer de Gesen (P&P)
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2gese.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2gese~ LAST #2 #2 #1 ~IDENTIFIED~ #1
    END
    // 14. Arc des fosses profondes
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2prcc.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2prcc~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 15. Arbalète infaillible
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2mitr.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2mitr~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 16. Fronde de l'âme de l'espace
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2fron.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2fron~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 17. "Sprotch"
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2sprc.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2sprc~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 18. La discorde des magiocrates +3
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2orag.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2orag~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
    // 19. Maorec Ertuï
    PATCH_IF FILE_EXISTS_IN_GAME ~pxl2asom.itm~ BEGIN
      ADD_STORE_ITEM ~pxl2asom~ LAST #0 #0 #0 ~IDENTIFIED~ #1
    END
